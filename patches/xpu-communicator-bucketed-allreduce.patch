+# LocalXPU patch: bound the number of distinct all-reduce message sizes.
+# oneCCL's host-staged path (CCL_TOPO_P2P_ACCESS=0) caches one host staging buffer per EXACT message size in
+# ccl::regular_buffer_cache and never evicts (src/sched/buffer/buffer_cache.cpp). Every new prefill-chunk length
+# therefore leaked a buffer of up to ~84 MB: +1.15 GB per worker for 12 varied prompts, flat with
+# CCL_BUFFER_CACHE=0 (which halves decode speed). Padding each eager all-reduce to a bounded bucket set keeps
+# the cache (and its speed) but caps it. Zero padding cannot change the reduced values: the result copied back
+# is bit-identical. Off unless VLLM_XPU_AR_PAD=1.
+_AR_PAD = os.environ.get("VLLM_XPU_AR_PAD") == "1"
+# Messages at or below _AR_PAD_MIN elements are not padded: decode batches are already padded to the XPU-graph
+# capture sizes (<= 40 tokens), so small sizes form a small bounded set, and padding them cost ~20% decode speed
+# (three extra kernels on each of ~128 all-reduces per step, measured 2026-09-29).
+_AR_PAD_MIN = int(os.environ.get("VLLM_XPU_AR_PAD_MIN", str(64 * 5120)))
+_AR_PAD_GRAN = int(os.environ.get("VLLM_XPU_AR_PAD_GRAN", str(1 << 21)))  # elements (4 MB fp16); power of two so the two regimes meet cleanly
+
+
+# Diagnostics (off unless VLLM_XPU_COLL_TRACE=1): log the Python stack of every torch.distributed
+# collective whose message is > 4 MB and not a bucket size, to find collectives that bypass the padding.
+if os.environ.get("VLLM_XPU_COLL_TRACE") == "1":
+    import functools, traceback
+    def _trace(fn, name):
+        @functools.wraps(fn)
+        def w(*a, **k):
+            try:
+                ts = [x for x in list(a) + list(k.values()) if isinstance(x, torch.Tensor)]
+                ts += [y for x in a if isinstance(x, (list, tuple)) for y in x if isinstance(y, torch.Tensor)]
+                nb = max((t.numel() * t.element_size() for t in ts), default=0)
+                if nb > (1 << 22) and nb % (1 << 22):
+                    logger.warning("COLLTRACE %s bytes=%d shapes=%s\n%s", name, nb, [tuple(t.shape) for t in ts],
+                                   "".join(traceback.format_stack(limit=14)[:-1]))
+            except Exception:
+                pass
+            return fn(*a, **k)
+        return w
+    for _n in ("all_reduce", "all_gather", "all_gather_into_tensor", "reduce_scatter", "reduce_scatter_tensor",
+               "broadcast", "all_to_all_single"):
+        if hasattr(dist, _n):
+            setattr(dist, _n, _trace(getattr(dist, _n), _n))
+
+
+def _ar_bucket(numel: int) -> int:
+    if numel <= _AR_PAD_GRAN:
+        return 1 << (numel - 1).bit_length()          # next power of two
+    return -(-numel // _AR_PAD_GRAN) * _AR_PAD_GRAN  # next multiple of the granule
+
 
